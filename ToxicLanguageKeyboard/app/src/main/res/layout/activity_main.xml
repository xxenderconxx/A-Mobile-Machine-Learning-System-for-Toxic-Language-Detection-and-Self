<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="fixed"
        app:tabGravity="fill">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_settings" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_contribute" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Settings Section -->
        <ScrollView
            android:id="@+id/view_settings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language_disclaimer"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="24dp"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btn_enable_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_enable_keyboard"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btn_select_keyboard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_select_keyboard"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btn_overlay_permission"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_overlay_permission"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_filtering"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/switch_filtering_label"
                    android:layout_marginBottom="32dp"
                    android:checked="true" />

                <EditText
                    android:id="@+id/et_test"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Test keyboard here..."
                    android:inputType="textLongMessage"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_toxicity_preview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model Confidence: 0.0% (Safe)"
                    android:textSize="12sp"
                    android:textColor="#757575"
                    android:layout_marginBottom="32dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_title"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_stats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detections: 0 | Edits: 0 | Ignored: 0"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <Button
                    android:id="@+id/btn_reset_stats"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_reset_metrics"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary" />

                <Button
                    android:id="@+id/btn_export_metrics"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_export_metrics"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary" />

                <Button
                    android:id="@+id/btn_clear_dictionary"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_clear_dictionary"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary" />

                <Button
                    android:id="@+id/btn_privacy_info"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_privacy_info"
                    android:textSize="12sp"
                    android:textColor="?attr/colorPrimary" />

            </LinearLayout>
        </ScrollView>

        <!-- Contribute Section -->
        <LinearLayout
            android:id="@+id/view_contribute"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Help Improve the Model"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tv_feedback_stats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="New Toxic Words: 0\nFalse Positives: 0"
                android:textSize="16sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_queued_contributions"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ListView
                android:id="@+id/lv_queued_data"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="16dp"
                android:divider="@android:color/darker_gray"
                android:dividerHeight="0.5dp" />

            <Button
                android:id="@+id/btn_upload_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_upload"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="By uploading, you help us refine the local filtering model. No personal identifying information is sent."
                android:textSize="12sp"
                android:textColor="#757575"
                android:gravity="center" />

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
