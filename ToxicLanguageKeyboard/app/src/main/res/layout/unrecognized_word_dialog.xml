<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unrecognized Vocabulary"
        android:textColor="#F57C00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/unrecognized_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="The word '...' was not found in our dictionary. Would you like to proceed or edit?"
        android:textColor="#333333"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_ignore"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Ignore"
            android:textColor="#757575" />

        <Button
            android:id="@+id/btn_add_to_dictionary"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/btn_add"
            android:textColor="#4CAF50" />

        <Button
            android:id="@+id/btn_mark_toxic"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/btn_mark_toxic"
            android:textColor="#D32F2F" />

        <Button
            android:id="@+id/btn_edit_word"
            android:layout_width="0dp"
            android:layout_weight="1.2"
            android:layout_height="wrap_content"
            android:text="@string/btn_edit_word"
            android:backgroundTint="#F57C00"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
