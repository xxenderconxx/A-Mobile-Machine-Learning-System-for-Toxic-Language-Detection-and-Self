rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user has ONE document in 'contributions', named by their hashed Android ID.
    match /contributions/{userId} {
      allow create: if request.resource.data.userId != null;
      allow update: if request.resource.data.userId != null
                    && (request.time > resource.data.timestamp + duration.value(1, 'm'));
      allow read, delete: if false;
    }

    // Feedback collection for unrecognized words and false positives from the service
    match /feedback/{docId} {
      allow create: if request.resource.data.userId != null;
      allow read, update, delete: if false;
    }

    // Research reports collection
    match /research_reports/{docId} {
      allow create: if request.resource.data.userId != null;
      allow read, update, delete: if false;
    }
  }
}